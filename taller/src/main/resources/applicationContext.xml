<?xml version="1.0" encoding="UTF-8"?>
<!--
    VERSION 2: CONFIGURACION BASADA EN ANNOTATIONS

    OJO: este archivo NO es la version XML del taller. Aqui no se declara
    ningun <bean>: su unica funcion es activar el escaneo de anotaciones.
    Los beans se declaran en las propias clases con @Repository, @Service,
    @Component y @Autowired.

    La version XML pura (con <bean>, <constructor-arg> y <property>) vive en
    la rama main, en este mismo archivo. Son archivos con el mismo nombre y
    contenido totalmente distinto, no los confundas al comparar las ramas.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <!-- Habilita el procesamiento de @Autowired, @PostConstruct y @PreDestroy -->
    <context:annotation-config/>

    <!-- Escanea los componentes anotados con @Repository, @Service y @Component -->
    <context:component-scan base-package="com.example"/>

</beans>
